NEXT_PUBLIC_APP_NAME=Lisent CRM
NEXT_PUBLIC_API_DOMAIN=http://localhost:3010
NEXT_PUBLIC_WEBSITE_DOMAIN=http://localhost:3010
NEXT_PUBLIC_API_BASE_PATH=/api/auth
NEXT_PUBLIC_WEBSITE_BASE_PATH=/auth
NEXT_PUBLIC_UI_ONLY_MODE=false

# Production (Docker/Dokploy runtime): public origin, no trailing slash. Aligns SuperTokens Node with the real URL when build-time NEXT_PUBLIC_* was wrong.
# APP_PUBLIC_ORIGIN=https://crm.lisent.ai

# Auth infra storage for future web/BFF membership data.
AUTH_DB_DSN=postgresql://lisent_auth_user:<password>@<host>:5432/lisent_auth

# SuperTokens CORE only (default port 3567). NOT your Next app URL.
# If the SDK errors with "301" on /apiversion, your URI hits a redirect (e.g. HTTP→HTTPS or wrong host):
# use the URL that returns 200 for GET /apiversion with no redirect — often http://core-service-name:3567 on Docker.
# If TLS terminates in front of Core, use https://... directly (not http:// that gets 301).
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_CORE_PORT=3567
SUPERTOKENS_CORE_API_KEYS=

CRM_BASE_URL=http://localhost:9090
CRM_INTERNAL_API_KEY=your-crm-api-key

AUTH_PGADMIN_DEFAULT_EMAIL=auth-admin@lisent.ai
AUTH_PGADMIN_DEFAULT_PASSWORD=<strong-password>
AUTH_PGADMIN_PORT=8082
